{
  "name": "best-quote-finder",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated Multi-Channel Service Discovery, Outreach & Quote Comparison Engine",
  "main": "server/index.js",
  "scripts": {
    "quote": "node cli.js",
    "auth:facebook": "node scripts/authSession.js facebook",
    "auth:nextdoor": "node scripts/authSession.js nextdoor",
    "auth:thumbtack": "node scripts/authSession.js thumbtack",
    "auth:google": "node scripts/authSession.js google",
    "scout:facebook": "node scripts/searchFacebookGroup.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "quote-comparison",
    "service-finder",
    "contractors",
    "automated-outreach",
    "rfq"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "playwright-core": "^1.65.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
