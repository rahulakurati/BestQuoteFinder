# ========================================================
# BestQuoteFinder - Environment Configuration Template
# ========================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to Git!

PORT=3001
VITE_API_URL=http://localhost:3001

# --- Email Outreach Configuration (Phase 1) ---
# Supports standard SMTP (Gmail App Passwords, SendGrid, Resend, or custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME="BestQuoteFinder RFQ"

# --- Google Discovery / Places API (Optional) ---
# If empty, the app will fall back to automated web scraping / search
GOOGLE_PLACES_API_KEY=

# --- Phase 2 Future Integrations (Placeholders) ---
# Facebook Graph API / Session Token for Marketplace & Groups
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Thumbtack Partner API or Session
THUMBTACK_ACCESS_TOKEN=

# Google Messages / RCS / WhatsApp (Phase 2 Messaging)
GOOGLE_MESSAGES_BRIDGE_URL=
WHATSAPP_API_TOKEN=

# Voice Calling Engine (Phase 2 - Vapi / Retell / Twilio)
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
